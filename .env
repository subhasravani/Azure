# === Flask Settings ===
FLASK_APP=application
FLASK_ENV=production
SECRET_KEY=your_secret_key_here

# === Azure SQL Database ===
SQL_SERVER=sqldb8.database.windows.net
SQL_DATABASE=SampleDB
SQL_USER=your_sql_username
SQL_PASSWORD=your_sql_password
SQL_DRIVER={ODBC Driver 18 for SQL Server}

# === Azure Blob Storage ===
BLOB_ACCOUNT=articlecmsstore
BLOB_STORAGE_KEY=your_storage_access_key
BLOB_CONTAINER=articleimages

# === Microsoft Authentication ===
CLIENT_SECRET=your_microsoft_app_client_secret
CLIENT_ID=5733ea08-c3f2-4dc7-9782-bf74bd60b4b1
AUTHORITY=https://login.microsoftonline.com/f958e84a-92b8-439f-a62d-4f45996b6d07
REDIRECT_PATH=/getAToken
SCOPE=User.Read
SESSION_TYPE=filesystem
